import json
import urllib.request

LEAGUE_ID = 152084
START_YEAR = 2014
END_YEAR = 2026
BASE_URL = "https://fleaflicker.com"

def get_json(endpoint):
    url = f"{BASE_URL}/{endpoint}"
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except Exception as e:
        print(f"Skipping {endpoint}: {e}")
        return None

def get_owner(team_obj):
    if not isinstance(team_obj, dict):
        return "Unknown"
    owners = team_obj.get("owners")
    if isinstance(owners, list):
        first_owner = next(iter(owners), None)
        if isinstance(first_owner, dict) and first_owner.get("displayName"):
            return first_owner.get("displayName")
    return team_obj.get("name", "Unknown")

seasons = []
games = []
drafts = []
league_name = f"League #{LEAGUE_ID}"

for yr in range(START_YEAR, END_YEAR + 1):
    print(f"Fetching {yr}...")
    st = get_json(f"FetchLeagueStandings?sport=NFL&league_id={LEAGUE_ID}&season={yr}")
    if not isinstance(st, dict) or "divisions" not in st:
        continue

    if isinstance(st.get("league"), dict) and st.get("league").get("name"):
        league_name = st.get("league").get("name")

    teams = []
    for div in st.get("divisions", []):
        for t in div.get("teams", []):
            pf_obj = t.get("pointsFor") if isinstance(t.get("pointsFor"), dict) else {}
            teams.append({
                "id": t.get("id"),
                "name": t.get("name", "Unknown"),
                "owner": get_owner(t),
                "rank": t.get("rankOverall", 99),
                "pf": pf_obj.get("value", 0)
            })
    seasons.append({"year": yr, "teams": teams})

    for wk in range(1, 19):
        sb = get_json(f"FetchLeagueScoreboard?sport=NFL&league_id={LEAGUE_ID}&season={yr}&scoring_period={wk}")
        if not isinstance(sb, dict) or not sb.get("games"):
            break
        for g in sb.get("games", []):
            h_score_obj = g.get("homeScore") if isinstance(g.get("homeScore"), dict) else {}
            a_score_obj = g.get("awayScore") if isinstance(g.get("awayScore"), dict) else {}
            h_pts = h_score_obj.get("score", {}).get("value", 0) if isinstance(h_score_obj.get("score"), dict) else 0
            a_pts = a_score_obj.get("score", {}).get("value", 0) if isinstance(a_score_obj.get("score"), dict) else 0
            if g.get("home") and g.get("away") and (h_pts > 0 or a_pts > 0):
                games.append({
                    "year": yr,
                    "week": wk,
                    "home": get_owner(g.get("home")),
                    "away": get_owner(g.get("away")),
                    "homePts": h_pts,
                    "awayPts": a_pts
                })

    dr = get_json(f"FetchLeagueDraftBoard?sport=NFL&league_id={LEAGUE_ID}&season={yr}")
    if isinstance(dr, dict) and isinstance(dr.get("rows"), list):
        first_row = next(iter(dr.get("rows")), None)
        if isinstance(first_row, dict):
            first_round = []
            for idx, cell in enumerate(first_row.get("cells", [])):
                player_obj = cell.get("player") if isinstance(cell.get("player"), dict) else {}
                pro_obj = player_obj.get("proPlayer") if isinstance(player_obj.get("proPlayer"), dict) else {}
                first_round.append({
                    "pick": f"1.{idx + 1}",
                    "manager": get_owner(cell.get("team")),
                    "player": pro_obj.get("nameFull", "Unknown"),
                    "pos": pro_obj.get("position", "")
                })
            drafts.append({"year": yr, "picks": first_round})

output = {
    "leagueName": league_name,
    "leagueId": LEAGUE_ID,
    "seasons": seasons,
    "games": games,
    "drafts": drafts
}

with open("data.json", "w", encoding="utf-8") as f:
    json.dump(output, f, indent=2)

print(f"SUCCESS: Saved {len(seasons)} seasons and {len(games)} games!")
